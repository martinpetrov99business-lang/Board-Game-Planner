@model GameNightDetailsViewModel

@{
    ViewData["Title"] = "Game Night Details";
}

<h1>Game Night Details</h1>

<div>
    <dl class="row">
        <dt class="col-sm-3">Title</dt>
        <dd class="col-sm-9">@Model.Title</dd>

        <dt class="col-sm-3">Date</dt>
        <dd class="col-sm-9">@Model.Date.ToString("f")</dd>

        <dt class="col-sm-3">Venue</dt>
        <dd class="col-sm-9">@Model.VenueName</dd>

        <dt class="col-sm-3">Venue address</dt>
        <dd class="col-sm-9">@Model.VenueAddress</dd>

        <dt class="col-sm-3">Guests</dt>
        <dd class="col-sm-9">@Model.SignedUpCount / @Model.MaxGuests</dd>

        <dt class="col-sm-3">Notes</dt>
        <dd class="col-sm-9">@(Model.Notes ?? "No notes provided.")</dd>

        <dt class="col-sm-3">Games</dt>
        <dd class="col-sm-9">
            @if (Model.Games.Any())
            {
                <ul class="list-unstyled mb-0">
                    @foreach (var game in Model.Games)
                    {
                        <li>
                            <a asp-controller="Games"
                               asp-action="Details"
                               asp-route-id="@game.Id">
                                @game.Title
                            </a>
                        </li>
                    }
                </ul>
            }
            else
            {
                <span class="text-muted">No games chosen yet.</span>
            }
        </dd>
    </dl>
</div>
@if (User.Identity?.IsAuthenticated != true)
{
    <a asp-area="Identity"
       asp-page="/Account/Login"
       class="btn btn-primary">
        Log in to join
    </a>
}
else if (Model.IsJoined)
{
    <form asp-action="Leave"
          asp-route-id="@Model.Id"
          method="post"
          class="d-inline">
        <button type="submit" class="btn btn-danger">Leave</button>
    </form>
}
else if (Model.Date > DateTime.Now && Model.SignedUpCount < Model.MaxGuests)
{
    <form asp-action="Join"
          asp-route-id="@Model.Id"
          method="post"
          class="d-inline">
        <button type="submit" class="btn btn-success">Join</button>
    </form>
}
else
{
    <p class="text-muted">
        This game night is full or has already started.
    </p>
}

<a asp-action="Index" class="btn btn-secondary">Back</a>

@if (Model.IsCreator)
{
    <a asp-action="Edit"
       asp-route-id="@Model.Id"
       class="btn btn-warning">
        Edit
    </a>

    <a asp-action="Delete"
       asp-route-id="@Model.Id"
       class="btn btn-danger">
        Delete
    </a>
}

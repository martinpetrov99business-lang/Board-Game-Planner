@model GameDetailsViewModel

@{
    ViewData["Title"] = "Delete Game";
}

<h1>Delete Game</h1>

<h3>Are you sure you want to delete this game?</h3>

<div>
    <h4>@Model.Title</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-3">Title</dt>
        <dd class="col-sm-9">@Model.Title</dd>

        <dt class="col-sm-3">Players</dt>
        <dd class="col-sm-9">
            @Model.MinPlayers - @Model.MaxPlayers
        </dd>

        <dt class="col-sm-3">Play Time</dt>
        <dd class="col-sm-9">
            @Model.PlayTimeMinutes min
        </dd>

        <dt class="col-sm-3">Complexity</dt>
        <dd class="col-sm-9">@Model.Complexity</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.Id" />

        <button type="submit" class="btn btn-danger">
            Delete
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancel
        </a>
    </form>
</div>